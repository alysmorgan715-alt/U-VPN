enum ConnectionStatus { disconnected, connecting, connected, reconnecting, error }

class VpnConfig {
  final String serverId;
  final VpnProtocol protocol;
  final Map<String, dynamic> parameters; // never logged
  final DnsConfig dns;
  final bool killSwitch;
}

abstract class VpnEngine {
  Future<void> prepare();
  Future<void> connect(VpnConfig config);
  Future<void> disconnect();
  Stream<ConnectionStatus> get statusStream;
  Future<VpnStats> stats();
  Future<void> dispose();
}

class VpnStats {
  final String? vpnIp;
  final Duration connectedFor;
  final int bytesUp;
  final int bytesDown;
  final int latencyMs;
  final VpnProtocol protocol;
}abstract class VpnPlatform {
  Future<bool> requestPermission();
  Future<void> startTunnel(VpnConfig config);
  Future<void> stopTunnel();
  Future<NetworkType> currentNetworkType();
  Stream<NetworkType> networkChanges();
  Future<void> applyKillSwitch(bool enabled);
  Future<void> applyDns(DnsConfig dns);
}class ConnectionManager {
  final VpnEngine _engine;
  final ServerRegistry _servers;
  final SettingsService _settings;
  final KillSwitch _killSwitch;
  final DnsManager _dns;

  ConnectionStatus _status = ConnectionStatus.disconnected;

  Future<void> connect({String? serverId}) async {
    _status = ConnectionStatus.connecting;
    final server = serverId != null
        ? _servers.byId(serverId)
        : await ServerSelector.pickBest(_servers, _settings);

    final cfg = VpnConfig(
      serverId: server.id,
      protocol: _settings.preferredProtocol ?? server.recommendedProtocol,
      parameters: await _servers.fetchRuntimeConfig(server.id),
      dns: _settings.dns,
      killSwitch: _settings.killSwitch,
    );

    if (_settings.killSwitch) await _killSwitch.arm();
    await _dns.apply(cfg.dns);
    await _engine.connect(cfg);
    _status = ConnectionStatus.connected;
  }

  Future<void> disconnect() async {
    await _engine.disconnect();
    await _killSwitch.disarm();
    _status = ConnectionStatus.disconnected;
  }
