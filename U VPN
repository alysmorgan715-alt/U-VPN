  static Future<Server> pickBest(
      ServerRegistry reg, SettingsService settings) async {
    final candidates = reg.authorized().where((s) =>
        s.supports(settings.preferredProtocol ?? s.recommendedProtocol));
    if (candidates.isEmpty) throw NoServerAvailable();

    Server? best;
    double bestScore = double.infinity;
    for (final s in candidates) {
      final score =
          0.35 * s.latencyNorm +
          0.25 * s.loadNorm +
          0.20 * (1 - s.reliability) +
          0.15 * s.distanceNorm +
          0.05 * (s.recommendedProtocol == settings.preferredProtocol ? 0 : 1);
      if (score < bestScore) { bestScore = score; best = s; }
    }
    return best!;
  }
