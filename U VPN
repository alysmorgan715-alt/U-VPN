  static const delays = [1, 2, 5, 10, 30]; // seconds, then stay at 30
  int attempt = 0;

  Future<void> onEvent(ConnectionManager mgr, ReconnectTrigger t) async {
    if (!mgr.settings.autoReconnect) return;
    while (attempt < delays.length + 5) {
      try {
        await mgr.connect();
        attempt = 0;
        return;
      } catch (_) {
        await Future.delayed(Duration(seconds: delays[attempt.clamp(0, delays.length-1)]));
        attempt++;
      }
    }
    mgr.emitError(AppError.reconnectExhausted);
  }
